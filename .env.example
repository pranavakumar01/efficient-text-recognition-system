# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed.
# Every value has a safe default, so `.env` is optional.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
OCR_APP_NAME="Efficient Text Recognition"
OCR_ENVIRONMENT=development          # development | production
OCR_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
OCR_LOG_JSON=false

# --- HTTP server -----------------------------------------------------------
OCR_HOST=127.0.0.1
OCR_PORT=8000
OCR_RELOAD=true
# Comma separated list of origins allowed by CORS.
OCR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# All paths are resolved relative to the project root when not absolute.
OCR_DATA_DIR=data
OCR_UPLOAD_DIR=data/uploads
OCR_ARTIFACT_DIR=artifacts
OCR_DATABASE_URL=sqlite:///artifacts/ocr.db

# --- Uploads ---------------------------------------------------------------
OCR_MAX_UPLOAD_MB=15

# --- Compute ---------------------------------------------------------------
# auto -> use CUDA when available, otherwise CPU.
OCR_DEVICE=auto                      # auto | cuda | cpu
OCR_ALLOW_AMP=true                   # mixed precision when on CUDA
OCR_NUM_WORKERS=0                    # DataLoader workers (0 is safest on Windows)

# --- Transformer OCR -------------------------------------------------------
# Hugging Face model ids used for the Transformer-OCR baseline.
OCR_TROCR_PRINTED_MODEL=microsoft/trocr-small-printed
OCR_TROCR_HANDWRITTEN_MODEL=microsoft/trocr-small-handwritten
# Keep the HF cache off the system drive.
HF_HOME=.cache/huggingface
# Set to 1 to forbid any network access from transformers.
TRANSFORMERS_OFFLINE=0
